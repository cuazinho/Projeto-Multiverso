rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MULTIVERSE EXPLORER SECURITY RULES
     * 
     * Nota: A permissão de leitura (get/list) é pública para que a galeria de 
     * exploradores seja visível por qualquer visitante da linha temporal.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    match /explorer_profiles/{explorerProfileId} {
      
      // Permitimos que qualquer pessoa veja os exploradores catalogados
      allow get, list: if true;

      // Apenas o dono autenticado pode criar ou atualizar seu próprio registro
      allow create: if isOwner(explorerProfileId) && request.resource.data.id == explorerProfileId;

      allow update: if isExistingOwner(explorerProfileId) && request.resource.data.id == resource.data.id;

      // Permitimos que usuários autenticados deletem para fins de reset do protótipo
      allow delete: if isSignedIn();
    }
  }
}